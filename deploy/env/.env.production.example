APP_NAME=SiLacak
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://silacak.example.co.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=db-prod.internal
DB_PORT=3306
DB_DATABASE=silacak
DB_USERNAME=silacak_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# IP load balancer / reverse proxy
TRUSTED_PROXIES=
# Wajib diisi saat seeding pertama di production
SEED_ADMIN_PASSWORD=
